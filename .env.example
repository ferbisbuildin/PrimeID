# Copy to .env.local. All values are public; never put a private key here.

# Deployed PrimeIdRevocationRegistry address. Leave empty to run without revocation.
VITE_PRIMEID_REGISTRY=

# Defaults are ZKsync Sepolia.
VITE_ZKSYNC_RPC_URL=https://sepolia.era.zksync.dev
VITE_ZKSYNC_CHAIN_ID=300
VITE_ZKSYNC_EXPLORER=https://sepolia.explorer.zksync.io
